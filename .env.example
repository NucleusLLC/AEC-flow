# AEC-flow environment — names only, never real values. Copy to .env.local for local work.
# (Only the billing block is documented here so far; the rest lives in README / Vercel.)

# ── AEC-flow subscription billing (Stripe Billing, decision D-5) ─────────────────────
# Each practice pays Nucleus LLC for AEC-flow. Billing is HIDDEN unless both the secret key
# and the monthly price are set. Setup: docs/billing/STRIPE-SUBSCRIPTIONS.md
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
# Optional: offer a yearly plan too.
STRIPE_PRICE_ID_YEARLY=
# Signing secret of the https://aec-flow.com/api/billing/webhook endpoint (whsec_...).
STRIPE_BILLING_WEBHOOK_SECRET=
