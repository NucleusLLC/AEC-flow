# AEC-flow environment variables — EXAMPLE ONLY, no real values.
# Copy what you need into .env.local (never commit that file).
# This file lists the Stripe variables added with Pay online (0.28.0);
# the app's other variables are documented where they are used.

# ── Pay online (Stripe Connect) — docs/finance/STRIPE.md ──────────────────
# Both must be set or the feature stays off (no Settings button, no Pay link).
# The PLATFORM's secret key (Nucleus LLC's Stripe account).
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret of the Connect webhook endpoint /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Not used: onboarding is Account Links, not OAuth, so no STRIPE_CONNECT_CLIENT_ID.

# Public address used to build /pay links and Stripe return URLs.
NEXTAUTH_URL=https://aec-flow.com
