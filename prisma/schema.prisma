// ═══════════════════════════════════════════════════════════════════════════
// BETA-Report — in-app feedback (Bug / Wish) from beta testers, with optional
// screenshot. Self-contained like the Construction-Admin module: the reporter
// is denormalised to plain string columns (no FK to User) so the feature stays
// portable and never blocks a write on an unmatched account. The screenshot is
// a downscaled JPEG data-URL (beta-grade storage); move to object storage later.
// ═══════════════════════════════════════════════════════════════════════════

enum BetaReportKind {
  BUG
  WISH
}

enum BetaReportStatus {
  NEW
  IN_REVIEW
  PLANNED
  RESOLVED
  CLOSED
}

// Standalone Tasks module — a personal/team to-do board. Self-contained
// (assignee denormalised to a name string, no FK) so it migrates independently;
// gains companyId scoping when the suite goes multi-tenant.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// A task proper, or a dated reminder. One table so a project's Agenda reads a
/// single source; `kind` is what the widgets branch on.
enum AgendaKind {
  TASK
  REMINDER
}

model Task {
  companyId String?
  id        String     @id @default(cuid())
  title     String
  notes     String?
  status    TaskStatus @default(TODO)
  priority  Priority   @default(MEDIUM)
  dueDate   DateTime?
  assignee  String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// Set when the item belongs to a project's dashboard/agenda; null for the
  /// practice-wide list at /tasks, which is why every column here is optional.
  projectId   String?
  kind        AgendaKind @default(TASK)
  /// User id the item is assigned to — this is what lets one member plan an
  /// action in another member's agenda. `assignee` stays as the display name.
  assigneeId  String?
  /// User id that created / delegated it, so an assignee can see who asked.
  createdById String?

  @@index([status])
  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

// Org-wide application config (system currency, practice profile, logo, footer,
// AI key) persisted as one JSON blob — replaces the filesystem .app-config.json,
// which isn't writable on serverless. Single row keyed "singleton" today; becomes
// per-company when multi-tenant. Read/written via lib/server/app-config-store.
model AppConfig {
  companyId String?
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

model BetaReport {
  id            String           @id @default(cuid())
  kind          BetaReportKind
  title         String
  description   String
  status        BetaReportStatus @default(NEW)
  pageUrl       String?
  userAgent     String?
  screenshot    String? // downscaled JPEG data-URL, or null
  reporterId    String?
  reporterName  String?
  reporterEmail String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([kind])
  @@index([status])
  @@index([createdAt])
  @@map("beta_reports")
}

/// Shared Document Generator output register (module integration layer).
/// ADDITIVE, non-destructive: records documents generated FROM the protected
/// Estimates/Schedule systems. It never stores or alters source records — only a
/// reference to the source system, record id, its version, and an optional
/// snapshot so an issued document never silently changes (spec §14).
model GeneratedDocument {
  companyId    String?
  id           String   @id @default(cuid())
  /// "estimates" | "schedule"
  sourceSystem String
  /// The document type produced (e.g. "cost_summary", "construction_schedule").
  docType      String
  title        String
  /// Source record identity (estimate id, or schedule projectId).
  sourceRecordId      String
  /// Source record version when one exists (Estimates: "V1.0"; Schedule: null —
  /// it has no version mechanism, see docs/protected-schedule-files.md §6).
  sourceRecordVersion String?
  /// Optional JSON snapshot / reference so the issued document is reproducible.
  sourceSnapshot      Json?
  /// The module active when the document was generated (e.g. "Module 3").
  generatedInModule String?
  moduleVersion     String?
  /// URL the document was rendered from (an existing print route).
  renderUrl String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([sourceSystem, sourceRecordId])
  @@index([createdAt])
  @@map("generated_documents")
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIAL
  RECEIVED
  CLOSED
  CANCELLED
}

/// Procurement — purchase orders issued to suppliers (Module 2, Construction
/// Administration). Additive and self-contained: it does not read or alter the
/// protected Estimates/Schedule systems. Line items live as JSON on the order;
/// subtotal/tax/total are denormalized from lib/procurement/calc.ts.
model PurchaseOrder {
  companyId     String?
  id            String              @id @default(cuid())
  poNumber      String
  projectId     String?
  projectName   String?
  vendorName    String
  vendorContact String?
  vendorEmail   String?
  status        PurchaseOrderStatus @default(DRAFT)
  currency      String              @default("USD")
  /// [{ description, quantity, unit, unitPrice }]
  lineItems     Json?
  subtotal      Decimal             @default(0)
  taxPercentage Decimal             @default(0)
  shipping      Decimal             @default(0)
  total         Decimal             @default(0)
  orderDate     DateTime?
  expectedDate  DateTime?
  receivedDate  DateTime?
  terms         String?
  notes         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([companyId, poNumber])
  @@index([projectId])
  @@index([status])
  @@map("purchase_orders")
}

enum MaterialSelectionStatus {
  PROPOSED
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  INSTALLED
}

/// Material / finish selections (Module 2, Construction Administration). A
/// per-project selection register — the finish schedule. Additive and
/// self-contained; it does not read or alter the protected systems. May
/// optionally reference a PurchaseOrder once the item is ordered (loose id, no
/// FK — keeps the tenant extension simple and the systems decoupled).
model MaterialSelection {
  companyId       String?
  id              String                  @id @default(cuid())
  tag             String
  projectId       String?
  projectName     String?
  category        String
  location        String?
  productName     String
  manufacturer    String?
  modelNumber     String?
  finish          String?
  specification   String?
  status          MaterialSelectionStatus @default(PROPOSED)
  currency        String                  @default("USD")
  quantity        Decimal                 @default(0)
  unit            String?
  unitCost        Decimal                 @default(0)
  totalCost       Decimal                 @default(0)
  supplier        String?
  purchaseOrderId String?
  approvedBy      String?
  selectedDate    DateTime?
  notes           String?
  createdById     String?
  createdByName   String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([companyId, tag])
  @@index([projectId])
  @@index([status])
  @@map("material_selections")
}

enum DesignDiscipline {
  ARCHITECTURE
  ENGINEERING
  INTERIOR
}

enum DeliverableType {
  DRAWING
  SPECIFICATION
  REPORT
  MODEL
  SCHEDULE
}

enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  ISSUED
  SUPERSEDED
  APPROVED
}

/// Design deliverables / drawing register (Module 1, Architecture / Engineering
/// / Interior Design). A per-discipline register of drawings and design
/// documents with revision + issue status. Additive and self-contained — it
/// does not read or alter the protected Estimates/Schedule systems. `number`
/// is user-entered (drawing numbering conventions e.g. A-101) and unique per
/// company.
model DesignDeliverable {
  companyId     String?
  id            String            @id @default(cuid())
  number        String
  title         String
  discipline    DesignDiscipline
  type          DeliverableType   @default(DRAWING)
  revision      String            @default("-")
  status        DeliverableStatus @default(DRAFT)
  projectId     String?
  projectName   String?
  scale         String?
  sheetSize     String?
  issuedTo      String?
  issuedDate    DateTime?
  dueDate       DateTime?
  fileLink      String?
  notes         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([companyId, number])
  @@index([projectId])
  @@index([discipline])
  @@index([status])
  @@map("design_deliverables")
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICE PROPOSAL MODULE (Module 1 — Architecture & Engineering Design)
//
// A professional service-proposal system, SEPARATE from the Business Development
// `Proposal` above (decision 2026-07-24, docs/proposal-module/01-PRODUCT-PLAN.md §3.1).
// Nothing in the existing Proposal family is modified. Fee math is authoritative in
// lib/proposals/engine; these tables persist the inputs plus the engine's denormalised
// totals for list/dashboard performance.
//
// Every model here carries `companyId` and MUST be listed in TENANT_MODELS (lib/db.ts).
// ─────────────────────────────────────────────────────────────────────────────

enum ServiceProposalKind {
  QUICK
  ADVANCED
}

enum ServiceProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED_FOR_ISSUE
  SENT
  UNDER_CLIENT_REVIEW
  REVISION_REQUESTED
  REVISED
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
  SUPERSEDED
  CONVERTED
}

enum CostBasisType {
  ESTIMATED_CONSTRUCTION_COST
  APPROVED_CONSTRUCTION_BUDGET
  CONTRACTOR_CONTRACT_SUM
  TOTAL_DEVELOPMENT_COST
  CONSTRUCTION_EXCL_LAND
  CONSTRUCTION_EXCL_FFE
  CONSTRUCTION_EXCL_EQUIPMENT
  CONSTRUCTION_EXCL_TAXES
  CONSTRUCTION_EXCL_FINANCING
  CUSTOM
}

enum FeeMethod {
  PERCENT_OF_BASIS
  FIXED
  HOURLY
  PER_AREA
  PER_UNIT
  PER_DELIVERABLE
  RETAINER
  MONTHLY
  MILESTONE
  COST_PLUS
  SUBCONSULTANT_PLUS_MARKUP
}

enum ServiceCategory {
  BASE
  OPTIONAL
  ADDITIONAL
}

enum TaxMode {
  EXCLUSIVE
  INCLUSIVE
}

/// A professional service proposal. The aggregate root of the module.
model ServiceProposal {
  companyId String?
  id        String @id @default(cuid())
  number    String
  title     String

  kind         ServiceProposalKind   @default(QUICK)
  status       ServiceProposalStatus @default(DRAFT)
  versionLabel String?
  revision     Int                   @default(1)

  clientId     String?
  clientName   String?
  projectId    String?
  projectName  String?
  contactName  String?
  contactEmail String?
  contactTitle String?

  currency        String  @default("USD")
  languageCode    String?
  taxJurisdiction String?

  costBasisType        CostBasisType?
  costBasisAmount      Decimal?
  costBasisSourceId    String?
  costBasisSourceField String?
  costBasisCapturedAt  DateTime?

  subtotal              Decimal @default(0)
  discountTotal         Decimal @default(0)
  taxableSubtotal       Decimal @default(0)
  taxTotal              Decimal @default(0)
  grandTotal            Decimal @default(0)
  baseFeeTotal          Decimal @default(0)
  optionalServicesTotal Decimal @default(0)
  reimbursablesTotal    Decimal @default(0)
  retainerAmount        Decimal @default(0)

  scopeSummary      String?
  exclusions        String?
  assumptions       String?
  terms             String?
  estimatedWeeks    Int?
  showFeeDerivation Boolean @default(true)
  documentStructure Json?
  /// [{ title, description, discipline, category, included }] — structured scope of services.
  scopeItems        Json?

  issuedAt   DateTime?
  validUntil DateTime?
  lockedAt   DateTime?

  preparedById String?
  reviewedById String?
  approvedById String?
  ownerId      String?
  notes        String?

  createdById   String?
  createdByName String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  disciplines          ServiceProposalDiscipline[]
  phases               ServiceProposalPhase[]
  feeComponents        ServiceProposalFeeComponent[]
  developmentCostItems ServiceProposalDevelopmentCostItem[]
  paymentMilestones    ServiceProposalPaymentMilestone[]
  reimbursables        ServiceProposalReimbursable[]
  discounts            ServiceProposalDiscount[]
  taxes                ServiceProposalTax[]
  statusHistory        ServiceProposalStatusHistory[]
  versions             ServiceProposalVersion[]
  attachments          Attachment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, clientId])
  @@index([companyId, projectId])
  @@index([companyId, createdAt])
  @@map("service_proposals")
}

model ServiceProposalDiscipline {
  companyId         String?
  id                String  @id @default(cuid())
  serviceProposalId String
  disciplineKey     String
  label             String
  leadName          String?
  scope             String?
  sortOrder         Int     @default(0)

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@index([serviceProposalId])
  @@map("service_proposal_disciplines")
}

model ServiceProposalPhase {
  companyId         String?
  id                String  @id @default(cuid())
  serviceProposalId String
  name              String
  percent           Decimal @default(0)
  amount            Decimal @default(0)
  sortOrder         Int     @default(0)

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@index([serviceProposalId])
  @@map("service_proposal_phases")
}

model ServiceProposalFeeComponent {
  companyId         String?
  id                String          @id @default(cuid())
  serviceProposalId String
  label             String
  disciplineKey     String?
  method            FeeMethod
  category          ServiceCategory @default(BASE)
  percent           Decimal?
  fixedAmount       Decimal?
  // Rate methods (hourly / per-area / per-unit / per-deliverable / monthly): quantity x rate.
  quantity          Decimal?
  unitRate          Decimal?
  // Markup methods (cost-plus / subconsultant): base cost x (1 + markup%).
  baseAmount        Decimal?
  markupPercent     Decimal?
  selected          Boolean         @default(false)
  taxable           Boolean         @default(true)
  calculatedAmount  Decimal         @default(0)
  overrideAmount    Decimal?
  overrideReason    String?
  overrideById      String?
  overrideAt        DateTime?
  sortOrder         Int             @default(0)

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@index([serviceProposalId])
  @@map("service_proposal_fee_components")
}

model ServiceProposalDevelopmentCostItem {
  companyId          String?
  id                 String  @id @default(cuid())
  serviceProposalId  String
  category           String
  amount             Decimal @default(0)
  includedInBasis    Boolean @default(true)
  isProfessionalFees Boolean @default(false)
  notes              String?
  sortOrder          Int     @default(0)

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@index([serviceProposalId])
  @@map("service_proposal_development_cost_items")
}

model ServiceProposalPaymentMilestone {
  companyId          String?
  id                 String  @id @default(cuid())
  serviceProposalId  String
  name               String
  trigger            String?
  percent            Decimal @default(0)
  amount             Decimal @default(0)
  invoiceDescription String?
  taxable            Boolean @default(true)
  sortOrder          Int     @default(0)

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@index([serviceProposalId])
  @@map("service_proposal_payment_milestones")
}

model ServiceProposalReimbursable {
  companyId         String?
  id                String  @id @default(cuid())
  serviceProposalId String
  label             String
  amount            Decimal @default(0)
  method            String?
  taxable           Boolean @default(true)
  sortOrder         Int     @default(0)

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@index([serviceProposalId])
  @@map("service_proposal_reimbursables")
}

model ServiceProposalDiscount {
  companyId         String?
  id                String    @id @default(cuid())
  serviceProposalId String
  label             String
  type              String
  value             Decimal   @default(0)
  reason            String?
  authorisedById    String?
  authorisedAt      DateTime?
  visibleToClient   Boolean   @default(true)
  sortOrder         Int       @default(0)

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@index([serviceProposalId])
  @@map("service_proposal_discounts")
}

model ServiceProposalTax {
  companyId          String?
  id                 String  @id @default(cuid())
  serviceProposalId  String
  name               String
  percent            Decimal @default(0)
  mode               TaxMode @default(EXCLUSIVE)
  registrationNumber String?
  sortOrder          Int     @default(0)

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@index([serviceProposalId])
  @@map("service_proposal_taxes")
}

model ServiceProposalStatusHistory {
  companyId         String?
  id                String                 @id @default(cuid())
  serviceProposalId String
  fromStatus        ServiceProposalStatus?
  toStatus          ServiceProposalStatus
  reason            String?
  byId              String?
  byName            String?
  createdAt         DateTime               @default(now())

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@index([serviceProposalId, createdAt])
  @@map("service_proposal_status_history")
}

/// An immutable snapshot of an issued proposal — the full computed result as JSON, plus a
/// reference to the rendered document. Append-only; never updated once written.
model ServiceProposalVersion {
  companyId         String?
  id                String   @id @default(cuid())
  serviceProposalId String
  versionLabel      String
  snapshot          Json
  documentUrl       String?
  reason            String?
  createdById       String?
  createdByName     String?
  createdAt         DateTime @default(now())

  proposal ServiceProposal @relation(fields: [serviceProposalId], references: [id], onDelete: Cascade)

  @@unique([serviceProposalId, versionLabel])
  @@index([serviceProposalId])
  @@map("service_proposal_versions")
}

/// Firm-configurable tax rates. NET-NEW infrastructure — the application previously had no
/// tax model at all (docs/proposal-module/03-CRITICAL-REVIEW.md §C1). Release A uses
/// single-rate exclusive tax; the model is shaped to grow.
model TaxRate {
  companyId          String?
  id                 String   @id @default(cuid())
  name               String
  percent            Decimal  @default(0)
  mode               TaxMode  @default(EXCLUSIVE)
  registrationNumber String?
  jurisdiction       String?
  isDefault          Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
  @@map("tax_rates")
}
