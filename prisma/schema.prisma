// ═══════════════════════════════════════════════════════════════════════════
// Cost-Estimation module (BOQ estimate sheets). Self-contained: projectId is a
// denormalised string (no FK) so it stays portable, mirroring the CA module.
// Numeric fields use Float (estimate inputs drive live JS recalculation in
// lib/estimates/calc.ts). @@map pins snake_case table names.
// ═══════════════════════════════════════════════════════════════════════════

enum EstimateStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

model CostEstimate {
  companyId String?
  id            String         @id @default(cuid())
  projectId     String?
  projectNumber String?
  projectName   String
  client        String?
  location      String?
  version       String         @default("V1.0")
  date          DateTime?
  currency      String         @default("USD")
  avgLaborRate  Float          @default(0)
  profitPct     Float          @default(0)
  bboPct        Float          @default(0)
  gfa           Float?
  status        EstimateStatus @default(DRAFT)
  amount        Float          @default(0)
  budget        Json? // Budget & Timeline config (schedule coupler + payment/retainage)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  categories EstimateCategory[]

  @@index([projectId])
  @@map("cost_estimates")
}

model EstimateCategory {
  id         String         @id @default(cuid())
  estimateId String
  name       String
  code       String?
  sortOrder  Int            @default(0)
  items      EstimateItem[]
  estimate   CostEstimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_categories")
}

model EstimateItem {
  id                  String           @id @default(cuid())
  categoryId          String
  task                String
  qty                 Float            @default(0)
  unit                String           @default("no")
  laborNorm           Float            @default(0)
  materialUnitCost    Float            @default(0)
  equipmentUnitCost   Float            @default(0)
  subcontractUnitCost Float            @default(0)
  poc                 Float            @default(0)
  code                String?
  sortOrder           Int              @default(0)
  // Calculation engine (Phase 1–5): per-line method + method-specific inputs.
  // All nullable → existing rows read back as Norm-Based (the default).
  calculationMethod   String?
  laborRatePerUnit    Float?
  assembly            Json?
  category            EstimateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("estimate_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// Project Schedule (Gantt) — persists the interactive programme. Tasks store the
// client-side task key (t1, s1, …) so dependsOn / parentId references survive a
// round-trip. `config` holds schedule-level settings (categories, calendar,
// status date) as JSON for later wiring. Keyed by projectId (projectNumber).
// ═══════════════════════════════════════════════════════════════════════════

model ProjectSchedule {
  companyId String?
  id            String         @id @default(cuid())
  projectId     String         @unique
  projectNumber String
  projectName   String
  client        String?
  manager       String?
  config        Json?
  tasks         ScheduleTask[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("project_schedules")
}

model ScheduleTask {
  id           String          @id @default(cuid())
  scheduleId   String
  taskKey      String // client-side task id (stable within a schedule)
  name         String
  discipline   String
  status       String
  start        String // ISO yyyy-mm-dd (string to match the app, no TZ drift)
  end          String
  progressPct  Float           @default(0)
  dependsOn    String[] // task keys (finish-to-start)
  assignee     String?
  parentId     String?
  durationUnit String?
  category     String?
  subCategory  String?
  sortOrder    Int             @default(0)
  schedule     ProjectSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("schedule_tasks")
}

// ═══════════════════════════════════════════════════════════════════════════
// Cost-Estimation — firm-wide price book (materials + equipment reference rates
// that feed estimate costing). Self-contained; @@map snake_case.
// ═══════════════════════════════════════════════════════════════════════════

enum PriceKind {
  MATERIAL
  EQUIPMENT
}

model PriceItem {
  companyId String?
  id        String    @id @default(cuid())
  kind      PriceKind
  code      String
  name      String
  category  String
  unit      String
  unitPrice Float     @default(0)
  supplier  String?
  note      String?
  region    String?
  currency  String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([kind])
  @@map("price_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// Cost-Estimation — firm-wide Norm Set (standard tasks with fixed labor norms +
// default costs that drive estimate line items). Self-contained; @@map snake_case.
// ═══════════════════════════════════════════════════════════════════════════

model NormSetTask {
  companyId String?
  id                  String  @id @default(cuid())
  trade               String
  task                String
  unit                String
  laborNorm           Float   @default(0)
  materialUnitCost    Float?
  equipmentUnitCost   Float?
  subcontractUnitCost Float?
  code                String?
  sortOrder           Int     @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("norm_set_tasks")
}

/* ──────────────── Land Development — commercial entities ────────────────────
 * Procurement chain (Vendor → Contract → Invoice → Payment) and sales side
 * (BuyerReservation → SalesContract). Self-contained, denormalised projectId. */

enum DevContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

enum DevInvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  DISPUTED
}

enum DevReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELLED
}

enum DevSalesContractStatus {
  DRAFT
  SIGNED
  CLOSED
  CANCELLED
}

model Vendor {
  companyId String?
  id        String  @id @default(cuid())
  projectId String
  name      String
  trade     String?
  contact   String?
  email     String?
  phone     String?
  notes     String?

  @@index([projectId])
  @@map("dev_vendors")
}

model DevContract {
  id            String            @id @default(cuid())
  projectId     String
  contractRef   String
  title         String
  vendorName    String?
  costCode      Int?
  value         Decimal           @default(0)
  retentionPct  Float             @default(0)
  status        DevContractStatus @default(DRAFT)
  startDate     DateTime?
  endDate       DateTime?
  notes         String?

  @@index([projectId])
  @@map("dev_contracts")
}

model DevInvoice {
  id            String           @id @default(cuid())
  projectId     String
  invoiceNumber String
  contractRef   String?
  vendorName    String?
  costCode      Int?
  amount        Decimal          @default(0)
  status        DevInvoiceStatus @default(DRAFT)
  dateIssued    DateTime?
  dateDue       DateTime?

  @@index([projectId])
  @@map("dev_invoices")
}

model DevPayment {
  id            String    @id @default(cuid())
  projectId     String
  invoiceNumber String?
  vendorName    String?
  amount        Decimal   @default(0)
  method        String?
  reference     String?
  datePaid      DateTime?

  @@index([projectId])
  @@map("dev_payments")
}

model BuyerReservation {
  id              String               @id @default(cuid())
  projectId       String
  lotNumber       String
  buyerName       String
  contact         String?
  broker          String?
  depositAmount   Decimal              @default(0)
  status          DevReservationStatus @default(ACTIVE)
  reservationDate DateTime?
  expiryDate      DateTime?
  notes           String?

  @@index([projectId])
  @@map("dev_buyer_reservations")
}

model SalesContract {
  id             String                 @id @default(cuid())
  projectId      String
  contractNumber String
  lotNumber      String
  buyerName      String
  salePrice      Decimal                @default(0)
  depositPaid    Decimal                @default(0)
  status         DevSalesContractStatus @default(DRAFT)
  signedDate     DateTime?
  closingDate    DateTime?
  notes          String?

  @@index([projectId])
  @@map("dev_sales_contracts")
}

// ═══════════════════════════════════════════════════════════════════════════
// Cost-Estimation — firm-wide General Conditions (preliminaries: insurance, site
// facilities, utilities…) feeding the estimate's optional GC markup line.
// ═══════════════════════════════════════════════════════════════════════════

model GeneralConditionItem {
  companyId String?
  id        String   @id @default(cuid())
  name      String
  unit      String
  qty       Float    @default(0)
  unitCost  Float    @default(0)
  note      String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("general_condition_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// Cost-Estimation — reusable estimate Templates (firm library). Nested
// categories/items stored as JSON (read-mostly, saved wholesale via "Save as…").
// id = dotted handle (e.g. "AEC.Traditional1LevelHouse").
// ═══════════════════════════════════════════════════════════════════════════

model EstimateTemplate {
  companyId String?
  id          String   @id
  name        String
  description String   @default("")
  categories  Json
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("estimate_templates")
}

// ═══════════════════════════════════════════════════════════════════════════
// Cost-Estimation — estimating Wiki (knowledge base). facts stored as JSON;
// image is an optional uploaded data-URL (overrides the built-in illoKey).
// ═══════════════════════════════════════════════════════════════════════════

model WikiArticle {
  companyId String?
  id        String   @id @default(cuid())
  title     String
  category  String
  tags      String[]
  summary   String
  facts     Json
  body      String?
  illoKey   String?
  image     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wiki_articles")
}

// ═══════════════════════════════════════════════════════════════════════════
// BETA-Report — in-app feedback (Bug / Wish) from beta testers, with optional
// screenshot. Self-contained like the Construction-Admin module: the reporter
// is denormalised to plain string columns (no FK to User) so the feature stays
// portable and never blocks a write on an unmatched account. The screenshot is
// a downscaled JPEG data-URL (beta-grade storage); move to object storage later.
// ═══════════════════════════════════════════════════════════════════════════

enum BetaReportKind {
  BUG
  WISH
}

enum BetaReportStatus {
  NEW
  IN_REVIEW
  PLANNED
  RESOLVED
  CLOSED
}

// Standalone Tasks module — a personal/team to-do board. Self-contained
// (assignee denormalised to a name string, no FK) so it migrates independently;
// gains companyId scoping when the suite goes multi-tenant.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  companyId String?
  id        String     @id @default(cuid())
  title     String
  notes     String?
  status    TaskStatus @default(TODO)
  priority  Priority   @default(MEDIUM)
  dueDate   DateTime?
  assignee  String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@map("tasks")
}

// Org-wide application config (system currency, practice profile, logo, footer,
// AI key) persisted as one JSON blob — replaces the filesystem .app-config.json,
// which isn't writable on serverless. Single row keyed "singleton" today; becomes
// per-company when multi-tenant. Read/written via lib/server/app-config-store.
model AppConfig {
  companyId String?
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

model BetaReport {
  id            String           @id @default(cuid())
  kind          BetaReportKind
  title         String
  description   String
  status        BetaReportStatus @default(NEW)
  pageUrl       String?
  userAgent     String?
  screenshot    String? // downscaled JPEG data-URL, or null
  reporterId    String?
  reporterName  String?
  reporterEmail String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([kind])
  @@index([status])
  @@index([createdAt])
  @@map("beta_reports")
}
