// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ⛔️⛔️⛔️ DO NOT RUN `prisma db push` (especially NOT `--accept-data-loss`) ⛔️⛔️⛔️
// This Supabase database is SHARED with NucleusLicenseOps (the licensing/billing system,
// github.com/greglacle/nucleus-licenseops). Its 26 tables (licenses, companies, usage_*,
// stripe_*, etc.) live in this same DB. They are mapped at the BOTTOM of this file as
// @@ignore'd models so push won't DROP them — but Prisma still cannot represent some of
// their features (partial indexes, RLS), so push can still ALTER them destructively.
// For schema changes here: use additive `ALTER TABLE` / `prisma migrate` only. See CLAUDE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DIRECTOR
  MANAGER
  STAFF
  VIEWER
}

enum Discipline {
  ARCHITECTURE
  STRUCTURAL
  INTERIOR
  MEP
  PROJECT_MANAGEMENT
}

enum Department {
  DESIGN
  ENGINEERING
  MANAGEMENT
  ADMIN
  FINANCE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  PATERNITY
  PUBLIC
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ClientType {
  DEVELOPER
  GOVERNMENT
  HOSPITALITY
  HEALTHCARE
  COMMERCIAL
  RESIDENTIAL
  PRIVATE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum ProposalStatus {
  DRAFT
  SENT
  PENDING
  APPROVED
  ON_HOLD
  REJECTED
  VOID
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MeetingType {
  CLIENT
  INTERNAL
  SITE
  AUTHORITY
  VIRTUAL
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String?
  name            String
  phone           String?
  avatarUrl       String?
  role            UserRole    @default(STAFF)
  discipline      Discipline?
  department      Department?
  status          UserStatus  @default(ACTIVE)
  capacity        Int         @default(100)
  utilisation     Int         @default(0)
  bio             String?
  skills          String[]
  annualLeaveTotal Int        @default(22)
  annualLeaveTaken Int        @default(0)
  workingHours    Json?
  preferences     Json?     // per-user settings blob (see lib/data/preferences.ts)
  officeLocation  String?
  joiningDate     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sessions         Session[]
  managedProjects  Project[]         @relation("ProjectManager")
  phases           PhaseAssignment[]
  leaveRequests    LeaveRequest[]
  meetingsAsAuthor MeetingMinute[]
  actionItems      ActionItem[]
  proposals        Proposal[]        @relation("ProposalOwner")
  followUps        Proposal[]        @relation("FollowUpOwner")
  activityLogs     ActivityLog[]
  notifications    Notification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Client {
  id            String        @id @default(cuid())
  name          String
  companyName   String?
  contactPerson String?
  email         String?
  phone         String?
  website       String?
  taxNumber     String?
  type          ClientType    @default(PRIVATE)
  status        ClientStatus  @default(ACTIVE)
  notes         String?
  tags          String[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  addresses    ClientAddress[]
  proposals    Proposal[]
  orders       Order[]
  projects     Project[]
  activityLogs ActivityLog[]
}

model ClientAddress {
  id        String  @id @default(cuid())
  clientId  String
  label     String
  line1     String
  line2     String?
  city      String?
  emirate   String?
  country   String  @default("UAE")
  isPrimary Boolean @default(false)
  client    Client  @relation(fields: [clientId], references: [id])
}

model Proposal {
  id                String         @id @default(cuid())
  refNumber         String         @unique
  title             String
  clientId          String
  ownerId           String
  followUpOwnerId   String?
  templateId        String?
  status            ProposalStatus @default(DRAFT)
  revision          Int            @default(1)
  currency          String         @default("AED")
  totalFee          Decimal
  scopeSummary      String?
  exclusions        String?
  assumptions       String?
  terms             String?
  estimatedDuration Int?
  sentAt            DateTime?
  approvedAt        DateTime?
  followUpDate      DateTime?
  lastContactDate   DateTime?
  followUpNotes     String?
  nextAction        String?
  validUntil        DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  client        Client             @relation(fields: [clientId], references: [id])
  owner         User               @relation("ProposalOwner", fields: [ownerId], references: [id])
  followUpOwner User?              @relation("FollowUpOwner", fields: [followUpOwnerId], references: [id])
  template      ProposalTemplate?  @relation(fields: [templateId], references: [id])
  lineItems     ProposalLineItem[]
  milestones    ProposalMilestone[]
  attachments   Attachment[]
  order         Order?
}

model ProposalLineItem {
  id          String      @id @default(cuid())
  proposalId  String
  description String
  discipline  Discipline?
  amount      Decimal
  isOptional  Boolean     @default(false)
  sortOrder   Int         @default(0)
  proposal    Proposal    @relation(fields: [proposalId], references: [id])
}

model ProposalMilestone {
  id         String   @id @default(cuid())
  proposalId String
  name       String
  percentage Int
  dueWeek    Int?
  proposal   Proposal @relation(fields: [proposalId], references: [id])
}

model ProposalTemplate {
  id         String      @id @default(cuid())
  name       String
  discipline Discipline?
  content    Json
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  proposals  Proposal[]
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  clientId          String
  proposalId        String?     @unique
  title             String
  serviceType       String
  status            OrderStatus @default(DRAFT)
  fee               Decimal
  currency          String      @default("AED")
  scopeSummary      String?
  siteAddress       String?
  expectedStartDate DateTime?
  expectedEndDate   DateTime?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  client      Client       @relation(fields: [clientId], references: [id])
  proposal    Proposal?    @relation(fields: [proposalId], references: [id])
  project     Project?
  attachments Attachment[]
}

model Project {
  id            String        @id @default(cuid())
  projectNumber String        @unique
  name          String
  clientId      String
  orderId       String?       @unique
  managerId     String
  status        ProjectStatus @default(ACTIVE)
  priority      Priority      @default(MEDIUM)
  description   String?
  siteAddress   String?
  disciplines   Discipline[]
  startDate     DateTime?
  targetEndDate DateTime?
  completedAt   DateTime?
  progressPct   Int           @default(0)
  contractValue Decimal?
  currency      String        @default("AED")
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client       Client          @relation(fields: [clientId], references: [id])
  order        Order?          @relation(fields: [orderId], references: [id])
  manager      User            @relation("ProjectManager", fields: [managerId], references: [id])
  phases       ProjectPhase[]
  meetings     MeetingMinute[]
  attachments  Attachment[]
  activityLogs ActivityLog[]
}

model ProjectPhase {
  id           String      @id @default(cuid())
  projectId    String
  parentId     String?
  name         String
  discipline   Discipline?
  status       PhaseStatus @default(NOT_STARTED)
  startDate    DateTime?
  endDate      DateTime?
  progressPct  Int         @default(0)
  sortOrder    Int         @default(0)
  notes        String?
  deliverables String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project      Project           @relation(fields: [projectId], references: [id])
  parent       ProjectPhase?     @relation("SubPhases", fields: [parentId], references: [id])
  children     ProjectPhase[]    @relation("SubPhases")
  assignments  PhaseAssignment[]
  dependencies PhaseDependency[] @relation("DependentPhase")
  dependents   PhaseDependency[] @relation("RequiredPhase")
}

model PhaseDependency {
  id          String       @id @default(cuid())
  dependentId String
  requiredId  String
  type        String       @default("FS")
  lagDays     Int          @default(0)
  dependent   ProjectPhase @relation("DependentPhase", fields: [dependentId], references: [id])
  required    ProjectPhase @relation("RequiredPhase", fields: [requiredId], references: [id])
}

model PhaseAssignment {
  id       String       @id @default(cuid())
  phaseId  String
  userId   String
  roleName String?
  phase    ProjectPhase @relation(fields: [phaseId], references: [id])
  user     User         @relation(fields: [userId], references: [id])

  @@unique([phaseId, userId])
}

model MeetingMinute {
  id           String      @id @default(cuid())
  projectId    String
  authorId     String
  title        String
  type         MeetingType @default(CLIENT)
  meetingDate  DateTime
  location     String?
  participants String[]
  summary      String?
  discussion   String?
  decisions    String?
  followUpDate DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project     Project      @relation(fields: [projectId], references: [id])
  author      User         @relation(fields: [authorId], references: [id])
  actionItems ActionItem[]
  attachments Attachment[]
}

model ActionItem {
  id          String       @id @default(cuid())
  meetingId   String
  assigneeId  String
  description String
  dueDate     DateTime?
  status      ActionStatus @default(OPEN)
  completedAt DateTime?
  meeting     MeetingMinute @relation(fields: [meetingId], references: [id])
  assignee    User          @relation(fields: [assigneeId], references: [id])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String
  type       LeaveType
  status     LeaveStatus @default(PENDING)
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
}

model PublicHoliday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  country   String   @default("UAE")
  isCompany Boolean  @default(false)
}

model Attachment {
  id         String   @id @default(cuid())
  filename   String
  url        String
  mimeType   String
  sizeBytes  Int
  proposalId String?
  orderId    String?
  projectId  String?
  meetingId  String?
  uploadedAt DateTime @default(now())

  proposal Proposal?     @relation(fields: [proposalId], references: [id])
  order    Order?        @relation(fields: [orderId], references: [id])
  project  Project?      @relation(fields: [projectId], references: [id])
  meeting  MeetingMinute? @relation(fields: [meetingId], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  meta       Json?
  clientId   String?
  projectId  String?
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════
// Construction Administration & Reporting module
// Self-contained: projectId and party fields are denormalised strings (no FK
// relations to existing models) so the module migrates independently and stays
// portable across regions (Aruba, NL, Colombia, Curaçao, Bonaire, USA). Money
// uses Decimal; labels are resolved at the app layer (lib/ca/i18n.ts) so the
// schema stays language-neutral. Column names follow the suite's camelCase
// convention; @@map pins the table names to the spec's snake_case.
// ═══════════════════════════════════════════════════════════════════════════

enum CaReportType {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  EXECUTIVE
  PROGRESS_CERTIFICATION
  BANK_DRAW
  COMPLETION
}

enum CaReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  ISSUED
  ARCHIVED
}

enum ChangeOrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  VOID
}

enum CaDiscipline {
  ARCHITECTURAL
  STRUCTURAL
  MECHANICAL
  ELECTRICAL
  PLUMBING
  CIVIL
  OTHER
}

enum RfiPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RfiStatus {
  OPEN
  ANSWERED
  CLOSED
  VOID
}

enum ImpactLevel {
  NONE
  POSSIBLE
  CONFIRMED
}

enum SiteInstructionStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  CLOSED
}

enum SubmittalStatus {
  REQUIRED
  SUBMITTED
  REVIEWED
  APPROVED
  APPROVED_AS_NOTED
  REVISE_AND_RESUBMIT
  REJECTED
}

enum DelayStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CLOSED
}

enum CertificationStatus {
  DRAFT
  ISSUED
  APPROVED
  ARCHIVED
}

enum PunchStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  REJECTED
}

model CaReport {
  id                    String         @id @default(cuid())
  projectId             String
  projectName           String?
  reportType            CaReportType
  reportNumber          String         @unique
  version               Int            @default(1)
  reportingPeriodStart  DateTime?
  reportingPeriodEnd    DateTime?
  preparedBy            String?
  reviewedBy            String?
  approvedBy            String?
  status                CaReportStatus @default(DRAFT)
  weatherSummary        String?
  siteConditions        String?
  workCompleted         String?
  workPlannedNextPeriod String?
  manpowerSummary       Json?
  equipmentSummary      Json?
  materialDeliveries    String?
  safetyIncidents       String?
  qualityIssues         String?
  delays                String?
  risks                 String?
  photos                Json?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([projectId])
  @@index([reportType])
  @@index([status])
  @@map("ca_reports")
}

model ChangeOrder {
  id                        String            @id @default(cuid())
  projectId                 String
  projectName               String?
  changeOrderNumber         String            @unique
  version                   Int               @default(1)
  title                     String
  description               String?
  reason                    String?
  requestedBy               String?
  contractorId              String?
  architectId               String?
  engineerId                String?
  ownerId                   String?
  status                    ChangeOrderStatus @default(DRAFT)
  costLabor                 Decimal           @default(0)
  costMaterial              Decimal           @default(0)
  costEquipment             Decimal           @default(0)
  costSubcontractor         Decimal           @default(0)
  overheadPercentage        Decimal           @default(0)
  profitPercentage          Decimal           @default(0)
  contingencyPercentage     Decimal           @default(0)
  vatPercentage             Decimal           @default(0)
  totalCost                 Decimal           @default(0)
  currency                  String            @default("USD")
  scheduleImpactDays        Int               @default(0)
  originalContractValue     Decimal           @default(0)
  approvedChangeOrdersToDate Decimal          @default(0)
  revisedContractValue      Decimal           @default(0)
  // Estimate-module link + BIM/5D placeholders (Phase 3)
  estimateLineItemId        String?
  bimElementId              String?
  revitCategory             String?
  ifcCategory               String?
  quantitySource            String?
  modelRevision             String?
  costLink5d                String?
  dateRequested             DateTime?
  dateSubmitted             DateTime?
  dateApproved              DateTime?
  attachments               Json?
  notes                     String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("change_orders")
}

model RfiLog {
  id            String       @id @default(cuid())
  projectId     String
  projectName   String?
  rfiNumber     String       @unique
  subject       String
  question      String?
  submittedBy   String?
  assignedTo    String?
  discipline    CaDiscipline @default(OTHER)
  priority      RfiPriority  @default(NORMAL)
  status        RfiStatus    @default(OPEN)
  response      String?
  responseBy    String?
  dateSubmitted DateTime?
  dateRequired  DateTime?
  dateResponded DateTime?
  linkedChangeOrderId String?
  attachments   Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("rfi_logs")
}

model SiteInstruction {
  id                  String                @id @default(cuid())
  projectId           String
  projectName         String?
  instructionNumber   String                @unique
  title               String
  description         String?
  issuedBy            String?
  issuedTo            String?
  discipline          CaDiscipline          @default(OTHER)
  costImpact          ImpactLevel           @default(NONE)
  scheduleImpact      ImpactLevel           @default(NONE)
  linkedChangeOrderId String?
  status              SiteInstructionStatus @default(DRAFT)
  dateIssued          DateTime?
  attachments         Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("site_instructions")
}

model SubmittalLog {
  id               String          @id @default(cuid())
  projectId        String
  projectName      String?
  submittalNumber  String          @unique
  title            String
  description      String?
  submittedBy      String?
  reviewedBy       String?
  discipline       CaDiscipline    @default(OTHER)
  status           SubmittalStatus @default(REQUIRED)
  dateRequired     DateTime?
  dateSubmitted    DateTime?
  dateReviewed     DateTime?
  attachments      Json?
  reviewerComments String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("submittal_logs")
}

model DelayNotice {
  id                String      @id @default(cuid())
  projectId         String
  projectName       String?
  delayNoticeNumber String      @unique
  title             String
  description       String?
  cause             String?
  responsibleParty  String?
  claimedDays       Int         @default(0)
  approvedDays      Int         @default(0)
  costImpact        Decimal     @default(0)
  status            DelayStatus @default(SUBMITTED)
  dateStarted       DateTime?
  dateResolved      DateTime?
  attachments       Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("delay_notices")
}

model ProgressCertification {
  id                        String              @id @default(cuid())
  projectId                 String
  projectName               String?
  certificationNumber       String              @unique
  version                   Int                 @default(1)
  inspectionDate            DateTime?
  certifiedBy               String?
  lenderName                String?
  contractorName            String?
  contractValue             Decimal             @default(0)
  currency                  String              @default("USD")
  previousPercentComplete   Decimal             @default(0)
  currentPercentComplete    Decimal             @default(0)
  workCompletedValue        Decimal             @default(0)
  retentionPercentage       Decimal             @default(0)
  retentionAmount           Decimal             @default(0)
  previousPaymentsValue     Decimal             @default(0)
  amountRecommendedForPayment Decimal           @default(0)
  deficiencies              String?
  recommendation            String?
  status                    CertificationStatus @default(DRAFT)
  photos                    Json?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("progress_certifications")
}

model PunchListItem {
  id               String      @id @default(cuid())
  projectId        String
  projectName      String?
  itemNumber       String      @unique
  location         String?
  description      String
  trade            String?
  responsibleParty String?
  priority         Priority    @default(MEDIUM)
  status           PunchStatus @default(OPEN)
  dateIdentified   DateTime?
  dueDate          DateTime?
  dateCompleted    DateTime?
  verifiedBy       String?
  photosBefore     Json?
  photosAfter      Json?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("punch_list_items")
}

/* ───────────────────────── Land Development / Parceling ─────────────────────
 * Self-contained module (denormalised `projectId` strings, no FKs to the core
 * project tables) — portable across Aruba / Caribbean / NL jurisdictions. Money
 * is Decimal; areas / rates / percentages are Float. See lib/development/calc.ts
 * for the calculation engine and lib/development/seed-data.ts for the demo. */

enum DevProjectStatus {
  PLANNING
  ACQUISITION
  PERMITTING
  INFRASTRUCTURE
  SALES
  CLOSEOUT
  COMPLETED
  ON_HOLD
  ARCHIVED
}

enum PropertyType {
  PROPERTY_LAND
  LONG_LEASE
  MIXED
}

enum DevProjectType {
  PARCEL_ONLY
  HOUSE_AND_PARCEL
  APARTMENT
  MIXED_USE
}

enum LotType {
  RESIDENTIAL
  COMMERCIAL
  CORNER
  PREMIUM
  GREEN
  UTILITY
  OTHER
}

enum LotStatus {
  DRAFT
  RESERVED
  OPTIONED
  SOLD
  CLOSED
}

enum DevPaymentStatus {
  NONE
  DEPOSIT_PAID
  PARTIAL
  PAID_IN_FULL
  OVERDUE
}

enum PermitTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  BLOCKED
  DONE
}

enum DevRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum BudgetStatus {
  BUDGETED
  COMMITTED
  IN_PROGRESS
  INVOICED
  PAID
  OVER_BUDGET
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  RESERVED
  NEGOTIATION
  WON
  LOST
}

enum FinancingStatus {
  CASH
  PRE_APPROVED
  PENDING
  DECLINED
  UNKNOWN
}

enum ScenarioKind {
  BASE
  CONSERVATIVE
  OPTIMISTIC
  CUSTOM
}

enum DevDocumentKind {
  PARCEL_DEED
  LEASE
  SURVEY
  TOPOGRAPHIC_PLAN
  PARCELING_PLAN
  DOW_DIP_SUBMISSION
  APPROVAL
  UTILITY_LETTER
  BUYER_CONTRACT
  INVOICE
  PAYMENT_RECEIPT
  SALES_AGREEMENT
  CLOSING_DOCUMENT
  OTHER
}

model DevelopmentProject {
  id                    String           @id @default(cuid())
  projectNumber         String           @unique
  name                  String
  location              String?
  clientOwner           String?
  developer             String?
  status                DevProjectStatus @default(PLANNING)
  currency              String           @default("AWG")
  totalParcelArea       Float            @default(0)
  zoningClassification  String?
  ropvArticleRef        String?
  propertyType          PropertyType     @default(PROPERTY_LAND)
  projectType           DevProjectType   @default(PARCEL_ONLY)
  startDate             DateTime?
  targetPermitDate      DateTime?
  targetInfraDate       DateTime?
  targetSalesLaunchDate DateTime?
  targetCloseoutDate    DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status])
  @@map("development_projects")
}

model LandAcquisition {
  id                    String  @id @default(cuid())
  projectId             String  @unique
  parcelAcquisitionCost Decimal @default(0)
  transferTax           Decimal @default(0)
  notaryCost            Decimal @default(0)
